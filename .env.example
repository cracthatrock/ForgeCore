DISCORD_GUILD_ID=
DATABASE_PATH=data/forge.sqlite
# Enable Message Content Intent in Discord's Developer Portal before setting true.
TICKET_TRANSCRIPTS=false
# Dashboard uses the same bot process and database. OAuth secret stays server-side.
DASHBOARD_ENABLED=true
DASHBOARD_URL=http://localhost:4190
DASHBOARD_PORT=4190
DASHBOARD_HOST=127.0.0.1
# Discord Developer Portal > OAuth2: add http://localhost:4190/auth/callback.
DISCORD_CLIENT_SECRET=
